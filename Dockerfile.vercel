# RADON Blender Worker — Vercel Container
# Real Blender runtime + FastAPI
# Designed for Vercel Fluid Compute

FROM python:3.12-slim

# ------------------------------------------------------------
# System dependencies required by Blender
# ------------------------------------------------------------

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    ca-certificates \
    xz-utils \
    libxrender1 \
    libxi6 \
    libxxf86vm1 \
    libxfixes3 \
    libxkbcommon0 \
    libsm6 \
    libgl1 \
    libegl1 \
    libopengl0 \
    libglib2.0-0 \
    libfontconfig1 \
    libfreetype6 \
    libxext6 \
    libx11-6 \
    libxau6 \
    libxdmcp6 \
    libxss1 \
    libxtst6 \
    libxcb1 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb-xinput0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

# ------------------------------------------------------------
# Install REAL Blender 4.2.4
# ------------------------------------------------------------

ENV BLENDER_VERSION=4.2
ENV BLENDER_SUBVERSION=4.2.23
ENV BLENDER_URL=https://mirror.blender.org/release/Blender4.2/blender-4.2.23-linux-x64.tar.xz

RUN curl -L --fail --retry 5 --retry-delay 3 \
    "${BLENDER_URL}" \
    -o /tmp/blender.tar.xz && \
    mkdir -p /opt/blender && \
    tar -xf /tmp/blender.tar.xz -C /opt/blender --strip-components=1 && \
    rm /tmp/blender.tar.xz && \
    ln -sf /opt/blender/blender /usr/bin/blender && \
    chmod +x /usr/bin/blender

# ------------------------------------------------------------
# VERIFY REAL BLENDER DURING BUILD
# ------------------------------------------------------------

RUN blender --background --version

# ------------------------------------------------------------
# RADON WORKER
# ------------------------------------------------------------

WORKDIR /app

COPY radon-blender-worker/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

COPY radon-blender-worker/ ./

# ------------------------------------------------------------
# RUNTIME CONFIGURATION
# ------------------------------------------------------------

ENV BLENDER_PATH=/usr/bin/blender
ENV OUTPUT_DIR=/tmp/radon-output
ENV JOB_TIMEOUT=120
ENV MAX_OUTPUT_SIZE_MB=100
ENV PYTHONUNBUFFERED=1
ENV HOST=0.0.0.0

RUN mkdir -p /tmp/radon-output

# ------------------------------------------------------------
# START FASTAPI
# Vercel provides PORT automatically
# ------------------------------------------------------------

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001}"]
